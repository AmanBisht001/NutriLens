# NutriLens Backend Environment Configuration

# Application
PROJECT_NAME="NutriLens API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL / Supabase / Local Docker)
# Local Docker Postgres:
DATABASE_URL="postgresql://nutrilens_user:nutrilens_password@localhost:5432/nutrilens_db"
# Supabase Postgres Example:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=False

# Supabase Storage & Services (Optional for label images)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-anon-or-service-role-key"
SUPABASE_STORAGE_BUCKET="product-labels"

# CORS Allowed Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]'

# JWT Security (Replace in production)
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
