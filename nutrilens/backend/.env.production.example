# ===========================================================================
# NutriLens Backend – Production Environment Configuration
# ===========================================================================

PROJECT_NAME="NutriLens API"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=False

# Database (Supabase PostgreSQL / AWS RDS / Render Managed Postgres)
# Direct connection (port 5432) or Supabase Transaction Pooler (port 6543):
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Connection Pooling Configuration
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=False

# Supabase Storage Configuration (for label photo uploads)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"
SUPABASE_STORAGE_BUCKET="product-labels"

# Production CORS Allowed Origins
# Specify exact production domain(s) of the frontend app
BACKEND_CORS_ORIGINS='["https://nutrilens.vercel.app", "https://app.nutrilens.com"]'

# JWT Cryptographic Security
# Generate using: openssl rand -hex 32
SECRET_KEY="generate-strong-random-hex-32-chars-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Logging & Operational Parameters
LOG_LEVEL="INFO"
OCR_ENGINE="paddle"
MAX_SCAN_IMAGE_SIZE_MB=10
